{
  "name": "@harness-visualization/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Ядро харнесса: цикл агента, контекст, тулы, провайдеры моделей",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokenomics": {
      "types": "./dist/tokenomics/browserSafe.d.ts",
      "default": "./dist/tokenomics/browserSafe.js"
    },
    "./evals": {
      "types": "./dist/evals/browserSafe.d.ts",
      "default": "./dist/evals/browserSafe.js"
    },
    "./branch": {
      "types": "./dist/branch/browserSafe.d.ts",
      "default": "./dist/branch/browserSafe.js"
    },
    "./adapters": {
      "types": "./dist/adapters/browserSafe.d.ts",
      "default": "./dist/adapters/browserSafe.js"
    },
    "./arena": {
      "types": "./dist/arena/browserSafe.d.ts",
      "default": "./dist/arena/browserSafe.js"
    },
    "./arena/docker": {
      "types": "./dist/arena/dockerSandbox.d.ts",
      "default": "./dist/arena/dockerSandbox.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@harness-visualization/embeddings": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.14",
    "node-html-markdown": "2.0.0",
    "undici": "7.17.0",
    "zod": "4.6.7"
  }
}
