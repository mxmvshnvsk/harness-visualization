{
  "model": {
    "providerName": "deepseek",
    "baseUrl": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "apiKeyVariable": "DEEPSEEK_API_KEY",
    "requestTimeoutMs": 120000,
    "maxOutputTokens": 2048,
    "reasoningStyle": "deepseek",
    "defaultReasoningEffort": "high",
    "requestExtras": {}
  },
  "prices": {
    "deepseek-flash": {
      "currency": "USD",
      "checkedAt": "2026-10-24",
      "source": "https://api-docs.deepseek.com/quick_start/pricing",
      "tariffs": [
        {
          "name": "peak",
          "inputCacheHitPerMillion": 0.006,
          "inputCacheMissPerMillion": 0.3,
          "outputPerMillion": 1.2,
          "schedule": {
            "weekdaysUtc": ["monday", "tuesday", "wednesday", "thursday", "friday"],
            "hoursUtc": [
              {
                "fromHour": 1,
                "toHour": 4
              },
              {
                "fromHour": 6,
                "toHour": 10
              }
            ]
          }
        },
        {
          "name": "offPeak",
          "inputCacheHitPerMillion": 0.003,
          "inputCacheMissPerMillion": 0.15,
          "outputPerMillion": 0.6
        }
      ]
    },
    "deepseek-v4-pro": {
      "currency": "USD",
      "checkedAt": "2026-10-24",
      "source": "https://api-docs.deepseek.com/quick_start/pricing",
      "tariffs": [
        {
          "name": "peak",
          "inputCacheHitPerMillion": 0.044,
          "inputCacheMissPerMillion": 1.32,
          "outputPerMillion": 3.96,
          "schedule": {
            "weekdaysUtc": ["monday", "tuesday", "wednesday", "thursday", "friday"],
            "hoursUtc": [
              {
                "fromHour": 1,
                "toHour": 4
              },
              {
                "fromHour": 6,
                "toHour": 10
              }
            ]
          }
        },
        {
          "name": "offPeak",
          "inputCacheHitPerMillion": 0.022,
          "inputCacheMissPerMillion": 0.66,
          "outputPerMillion": 1.98
        }
      ]
    }
  },
  "agent": {
    "maxIterations": 10
  },
  "context": {
    "preset": "demo",
    "limits": { "demo": 12000, "stress": 6000, "real": 1000000 },
    "toolResultLimits": { "demo": 1500, "stress": 800, "real": 25000 },
    "thresholdPercent": 80,
    "clearTargetPercent": 60,
    "compactionModel": null,
    "charsPerToken": 3.24
  },
  "workspace": {
    "directory": "workspace",
    "seedDirectory": "examples/workspace"
  },
  "permissions": {
    "defaultDecision": "ask",
    "effects": {
      "read": "allow",
      "write": "allow",
      "delete": "ask",
      "network": "allow"
    },
    "tools": {},
    "rules": [
      {
        "description": "Регламенты — только чтение",
        "pathPattern": "regulations/**",
        "effect": "write",
        "decision": "deny"
      },
      {
        "description": "Регламенты нельзя удалять",
        "pathPattern": "regulations/**",
        "effect": "delete",
        "decision": "deny"
      }
    ]
  },
  "webFetch": {
    "requestTimeoutMs": 15000,
    "maxDownloadBytes": 2000000,
    "maxCharacters": 20000,
    "maxRedirects": 5,
    "allowPrivateNetwork": false
  },
  "network": {
    "defaultRoute": "proxy",
    "rules": [
      {
        "description": "Поиск Яндекса работает без VPN — напрямую",
        "hostPattern": "*.yandex.net",
        "route": "direct"
      }
    ]
  },
  "search": {
    "provider": "yandex",
    "defaultMaxResults": 5,
    "tavily": {
      "baseUrl": "https://api.tavily.com",
      "apiKeyVariable": "TAVILY_API_KEY",
      "requestTimeoutMs": 20000,
      "searchDepth": "basic"
    },
    "yandex": {
      "baseUrl": "https://searchapi.api.cloud.yandex.net",
      "apiKeyVariable": "YANDEX_SEARCH_API_KEY",
      "folderIdVariable": "YANDEX_SEARCH_FOLDER_ID",
      "requestTimeoutMs": 20000,
      "searchType": "SEARCH_TYPE_RU",
      "maxPassages": 2,
      "prices": {
        "currency": "RUB",
        "synchronousDayPerThousand": 488,
        "synchronousNightPerThousand": 366,
        "checkedAt": "2026-10-24",
        "source": "https://aistudio.yandex.ru/ru/docs/search-api/pricing"
      }
    }
  },
  "server": {
    "port": 4317,
    "permissionTimeoutSeconds": 120,
    "questionTimeoutSeconds": 900
  },
  "grounding": {
    "similarityThreshold": 0.87
  },
  "retrieval": {
    "mode": "tool",
    "toolName": "kedr__semantic_search",
    "limit": 5
  },
  "skills": {
    "directory": "skills",
    "always": [],
    "manual": ["meeting-summary"]
  },
  "mcpServers": [
    {
      "name": "kedr",
      "description": "База знаний компании «Кедр Софт»: регламенты, проекты, встречи, FAQ",
      "command": "node",
      "args": ["packages/mcp-server/dist/main.js"],
      "trustAnnotations": true,
      "hiddenTools": ["hybrid_search"]
    }
  ],
  "traces": {
    "directory": "traces"
  }
}
