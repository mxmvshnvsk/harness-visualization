{
  "model": {
    "providerName": "deepseek",
    "baseUrl": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "apiKeyVariable": "DEEPSEEK_API_KEY",
    "requestTimeoutMs": 120000,
    "maxOutputTokens": 8192,
    "reasoningStyle": "deepseek",
    "defaultReasoningEffort": "high",
    "requestExtras": {},
    "topLogprobs": 0,
    "prefixCompletionBaseUrl": "https://api.deepseek.com/beta"
  },
  "providers": {
    "openrouter": {
      "providerName": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyVariable": "OPENROUTER_API_KEY",
      "dialect": "openrouter"
    },
    "openai": {
      "providerName": "OpenAI напрямую",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyVariable": "OPENAI_API_KEY",
      "dialect": "openai"
    },
    "ollama": {
      "providerName": "Ollama локально",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "apiKeyVariable": null,
      "dialect": "openai"
    }
  },
  "models": {
    "glm-4.6": {
      "provider": "openrouter",
      "model": "z-ai/glm-4.6",
      "label": "GLM 4.6",
      "capabilities": { "reasoning": true, "cache": true, "logprobs": false }
    },
    "claude-sonnet": {
      "provider": "openrouter",
      "model": "anthropic/claude-sonnet-4.5",
      "label": "Claude Sonnet 4.5",
      "capabilities": { "reasoning": true, "cache": true, "logprobs": false }
    },
    "gpt-mini": {
      "provider": "openai",
      "model": "gpt-5-mini",
      "label": "GPT-5 mini",
      "reasoningStyle": "openai",
      "outputTokenParameter": "max_completion_tokens",
      "capabilities": {
        "reasoning": true,
        "cache": true,
        "logprobs": false,
        "reasoningEfforts": ["low", "high"]
      }
    },
    "qwen-local": {
      "provider": "ollama",
      "model": "qwen3:8b",
      "label": "Qwen3 8B",
      "capabilities": { "logprobs": false }
    }
  },
  "prices": {
    "deepseek-flash": {
      "currency": "USD",
      "checkedAt": "2026-10-24",
      "source": "https://api-docs.deepseek.com/quick_start/pricing",
      "tariffs": [
        {
          "name": "peak",
          "inputCacheHitPerMillion": 0.006,
          "inputCacheMissPerMillion": 0.3,
          "outputPerMillion": 1.2,
          "schedule": {
            "weekdaysUtc": ["monday", "tuesday", "wednesday", "thursday", "friday"],
            "hoursUtc": [
              {
                "fromHour": 1,
                "toHour": 4
              },
              {
                "fromHour": 6,
                "toHour": 10
              }
            ]
          }
        },
        {
          "name": "offPeak",
          "inputCacheHitPerMillion": 0.003,
          "inputCacheMissPerMillion": 0.15,
          "outputPerMillion": 0.6
        }
      ]
    },
    "deepseek-v4-pro": {
      "currency": "USD",
      "checkedAt": "2026-10-24",
      "source": "https://api-docs.deepseek.com/quick_start/pricing",
      "tariffs": [
        {
          "name": "peak",
          "inputCacheHitPerMillion": 0.044,
          "inputCacheMissPerMillion": 1.32,
          "outputPerMillion": 3.96,
          "schedule": {
            "weekdaysUtc": ["monday", "tuesday", "wednesday", "thursday", "friday"],
            "hoursUtc": [
              {
                "fromHour": 1,
                "toHour": 4
              },
              {
                "fromHour": 6,
                "toHour": 10
              }
            ]
          }
        },
        {
          "name": "offPeak",
          "inputCacheHitPerMillion": 0.022,
          "inputCacheMissPerMillion": 0.66,
          "outputPerMillion": 1.98
        }
      ]
    }
  },
  "agent": {
    "maxIterations": 10
  },
  "context": {
    "preset": "demo",
    "limits": { "demo": 12000, "stress": 6000, "real": 1000000 },
    "toolResultLimits": { "demo": 1500, "stress": 800, "real": 25000 },
    "thresholdPercent": 80,
    "clearTargetPercent": 60,
    "compactionModel": null,
    "charsPerToken": 3.24
  },
  "workspace": {
    "directory": "workspaces/demo",
    "seedDirectory": "examples/workspace",
    "blankDirectory": "workspaces/blank"
  },
  "permissions": {
    "defaultDecision": "ask",
    "effects": {
      "read": "allow",
      "write": "allow",
      "delete": "ask",
      "network": "allow",
      "delegate": "allow"
    },
    "tools": {},
    "rules": [
      {
        "description": "Регламенты — только чтение",
        "pathPattern": "regulations/**",
        "effect": "write",
        "decision": "deny"
      },
      {
        "description": "Регламенты нельзя удалять",
        "pathPattern": "regulations/**",
        "effect": "delete",
        "decision": "deny"
      }
    ]
  },
  "webFetch": {
    "requestTimeoutMs": 15000,
    "maxDownloadBytes": 2000000,
    "maxCharacters": 20000,
    "maxRedirects": 5,
    "allowPrivateNetwork": false
  },
  "network": {
    "defaultRoute": "proxy",
    "rules": [
      {
        "description": "Поиск Яндекса работает без VPN — напрямую",
        "hostPattern": "*.yandex.net",
        "route": "direct"
      }
    ]
  },
  "search": {
    "provider": "yandex",
    "defaultMaxResults": 5,
    "tavily": {
      "baseUrl": "https://api.tavily.com",
      "apiKeyVariable": "TAVILY_API_KEY",
      "requestTimeoutMs": 20000,
      "searchDepth": "basic"
    },
    "yandex": {
      "baseUrl": "https://searchapi.api.cloud.yandex.net",
      "apiKeyVariable": "YANDEX_SEARCH_API_KEY",
      "folderIdVariable": "YANDEX_SEARCH_FOLDER_ID",
      "requestTimeoutMs": 20000,
      "searchType": "SEARCH_TYPE_RU",
      "maxPassages": 2,
      "prices": {
        "currency": "RUB",
        "synchronousDayPerThousand": 488,
        "synchronousNightPerThousand": 366,
        "checkedAt": "2026-10-24",
        "source": "https://aistudio.yandex.ru/ru/docs/search-api/pricing"
      }
    }
  },
  "server": {
    "port": 4317,
    "permissionTimeoutSeconds": 120,
    "questionTimeoutSeconds": 900
  },
  "grounding": {
    "similarityThreshold": 0.87
  },
  "retrieval": {
    "mode": "tool",
    "toolName": "kedr__semantic_search",
    "limit": 5
  },
  "skills": {
    "directory": "skills",
    "always": [],
    "manual": ["meeting-summary"]
  },
  "subagents": {
    "enabled": false,
    "parallel": true,
    "agents": {
      "researcher": {
        "modelKey": null,
        "description": "Ищет и читает документы базы знаний и рабочей папки, возвращает факты со ссылками. Только чтение: ничего не пишет и не ходит в интернет.",
        "instructions": "Сначала найди подходящие документы поиском, потом прочитай нужные целиком. В отчёт — только то, что прочитал сам.",
        "tools": [
          "kedr__search",
          "kedr__semantic_search",
          "kedr__read_document",
          "kedr__list_documents",
          "list_files",
          "read_file",
          "search_files"
        ],
        "maxIterations": 6,
        "reasoningEffort": "low"
      }
    }
  },
  "orchestration": {
    "modelKey": null
  },
  "mcpServers": [
    {
      "name": "kedr",
      "description": "База знаний компании «Кедр Софт»: регламенты, проекты, встречи, FAQ",
      "command": "node",
      "args": ["packages/mcp-server/dist/main.js"],
      "trustAnnotations": true,
      "hiddenTools": ["hybrid_search"]
    }
  ],
  "traces": {
    "directory": "traces"
  }
}
