{
  "name": "harness-visualization",
  "version": "0.0.0",
  "private": true,
  "description": "Учебный харнесс для ИИ-агентов с визуализацией потока данных",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "chat": "pnpm run build && node packages/harness/dist/cli/main.js",
    "check-grounding": "pnpm --filter @harness-visualization/harness... run build && node packages/harness/dist/cli/mainCheckGrounding.js",
    "rag-index": "pnpm --filter @harness-visualization/mcp-server... run build && cross-env NODE_USE_ENV_PROXY=1 node packages/mcp-server/dist/mainRagIndex.js",
    "compare-runs": "pnpm run build && node packages/harness/dist/cli/mainCompareRuns.js",
    "compare-search": "pnpm --filter @harness-visualization/mcp-server... run build && node packages/mcp-server/dist/mainCompareSearch.js",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --filter @harness-visualization/embeddings run build && pnpm --recursive run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
