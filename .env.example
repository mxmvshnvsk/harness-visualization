# Скопируйте этот файл в .env и заполните ключи.
# Файл .env не попадает в git.

# Ключ DeepSeek API: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Веб-поиск (необязателен): провайдер выбирается в harness.config.json (search.provider)
# или флагом --search. Без ключа выбранного провайдера тул web_search не регистрируется.

# Tavily: https://app.tavily.com — 1000 запросов в месяц бесплатно
TAVILY_API_KEY=

# Yandex Search API: https://aistudio.yandex.ru — API-ключ и ID каталога
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
